{
  "version": "2.0.0",
  "options": {
    "env": {}
  },
  "inputs": [],
  "problemMatchers": [
    {
      "name": "devcontainer-features-test",
      "owner": "devcontainer",
      "source": "devcontainer-features-test",
      "severity": "error",
      "pattern": [
        {
          "regexp": "^❌ Failed:\\s+'([^']+)'",
          "message": 1
        }
      ],
      "background": {
        "activeOnStart": true,
        "beginsPattern": "^⏳ Building test container",
        "endsPattern": "^\\s*================== TEST REPORT =================="
      }
    },
    {
      "name": "devcontainer-test-check-failure",
      "owner": "devcontainer",
      "pattern": {
        "regexp": "^❌ (.+) check failed\\.",
        "message": 1,
        "severity": "error"
      }
    },
    {
      "name": "devcontainer-feature-install-error",
      "owner": "devcontainer",
      "pattern": {
        "regexp": "^ERROR: Feature \"([^\"]+)\" .* failed to install!",
        "message": 1,
        "severity": "error"
      }
    }
  ],
  "tasks": [
    {
      "type": "process",
      "label": "Test Devcontainers",
      "detail": "Run full test suite for devcontainers features",
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "icon": {
        "color": "terminal.ansiMagenta",
        "id": "thinking"
      },
      "command": "devcontainer",
      "args": [
        "features", 
        "test"
      ],
      "problemMatcher": [
        "$devcontainer-features-test",
        "$devcontainer-test-check-failure",
        "$devcontainer-feature-install-error"
      ]
    }
  ]
}
