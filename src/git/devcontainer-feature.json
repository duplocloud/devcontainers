{
  "name": "Git Configuration",
  "id": "git",
  "version": "1.0.3",
  "description": "Installs git plugins and configures global gitignore",
  "documentationURL": "https://github.com/duplocloud/devcontainers/tree/main/src/git",
  "options": {
    "installGitKraken": {
      "type": "boolean",
      "default": false,
      "description": "Install GitKraken CLI (gk) for enhanced git operations"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "eamodio.gitlens"
      ]
    }
  },
  "installsAfter": [
    "ghcr.io/duplocloud/devcontainers/onepassword-cli",
    "ghcr.io/devcontainers/features/git"
  ],
  "dependsOn": {
    "ghcr.io/devcontainers/features/git:1": {}
  },
  "onCreateCommand": "bash /usr/local/share/git-on-create.sh"
}
